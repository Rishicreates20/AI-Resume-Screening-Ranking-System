# Copy to .env and fill in. Never commit .env.

# LLM provider key (default provider in config.yaml is Groq: https://console.groq.com/keys).
# Leave empty to run in rules-only mode.
GROQ_API_KEY=

# Optional: GitHub token (fine-grained, public repositories read-only).
# Without it GitHub allows 60 requests/hour; with it, 5000/hour.
GITHUB_TOKEN=
